{
  "name": "website",
  "version": "1.1.0",
  "description": "Official website and documentation for Role Reactor Discord bot",
  "type": "module",
  "private": true,
  "keywords": [
    "discord",
    "bot",
    "roles",
    "documentation",
    "next.js"
  ],
  "author": "rolereactor",
  "license": "MIT",
  "homepage": "https://rolereactor.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/rolereactor/website"
  },
  "scripts": {
    "build": "next build && node scripts/after-build.js",
    "dev": "next dev --turbo --port 8080",
    "dev:prod": "dotenv -e .env.production -o -- next dev --turbo --port 8080",
    "start": "HOSTNAME=localhost PORT=8080 node --env-file=.env.local .next/standalone/apps/website/server.js",
    "start:prod": "HOSTNAME=localhost PORT=8080 node --env-file=.env.production .next/standalone/apps/website/server.js",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "postinstall": "fumadocs-mdx",
    "analyze": "ANALYZE=true next build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@metamask/connect-evm": "^2.1.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-wagmi": "^1.8.23",
    "@sentry/nextjs": "^10.42.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vercel/analytics": "^1.5.0",
    "@walletconnect/ethereum-provider": "^2.24.0",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@x402/svm": "^2.25.0",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "15.6.5",
    "fumadocs-mdx": "11.7.0",
    "fumadocs-ui": "15.6.5",
    "lucide-react": "^0.525.0",
    "motion": "^12.23.24",
    "next": "15.4.10",
    "next-auth": "5.0.0-beta.30",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "require-in-the-middle": "^8.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "swr": "^2.4.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
